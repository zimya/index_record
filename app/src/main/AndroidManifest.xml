<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 关键：声明 SDK 版本 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <queries>
        <package android:name="com.zhihu.android" />
        <package android:name="com.douban.frodo" />
        <package android:name="com.baidu.tieba" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.sina.weibo" />
        <package android:name="com.weico.international" />
        <package android:name="com.coolapk.market" />
        <package android:name="com.hupu.games" />
        <package android:name="com.max.xiaoheihe" />
        <package android:name="xyz.blueskyweb.app" />
        <package android:name="gov.pianzong.androidnga" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:name=".App"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
    >

	    <!-- 这里的 android:exported="true" 是 Android 12+ 必须的 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Webrecorder"
            android:configChanges="locale|layoutDirection|orientation|screenSize|screenLayout|keyboardHidden"
        >
	        <intent-filter>
	            <!-- 这两行决定了它会显示在桌面上 -->
	            <action android:name="android.intent.action.MAIN" />
	            <category android:name="android.intent.category.LAUNCHER" />
	        </intent-filter>
	    </activity>

        <!-- 匹配系统/宿主应用的通用 queries 声明（CustomTabs / HTTP / HTTPS），确保在 Android 11+ 上对宿主应用可见 -->
        <activity
            android:name=".ui.VisibilityHolderActivity"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>

        <service
            android:name=".provider.SyncHostService"
            android:exported="true"
        >
            <intent-filter>
                <action
                    android:name="android.support.customtabs.action.CustomTabsService"
                />
            </intent-filter>
        </service>

        <meta-data android:name="xposedmodule" android:value="true" />

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope"
        />

        <meta-data
            android:name="xposeddescription"
            android:value="记录知乎、豆瓣、X、Threads、Reddit 和百度贴吧的浏览内容"
        />

        <meta-data android:name="xposedminversion" android:value="102" />
        <!-- exported=true 允许外部进程（Zhihu）访问 -->
        <provider
            android:name=".provider.HookDataProvider"
            android:authorities="com.melonhu.indexrecord.provider"
            android:exported="true"
            android:enabled="true"
        />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
