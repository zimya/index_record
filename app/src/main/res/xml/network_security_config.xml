<?xml version="1.0" encoding="utf-8" ?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Observed Tieba avatar/emoticon responses supply HTTP URLs on these exact hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">tb.himg.baidu.com</domain>
        <domain includeSubdomains="false">tb1.bdstatic.com</domain>
        <domain includeSubdomains="true">coolapk.com</domain>
        <domain includeSubdomains="true">hupu.com</domain>
        <domain includeSubdomains="true">hoopchina.com.cn</domain>
    </domain-config>
</network-security-config>
